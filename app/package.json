{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun --watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "bun server/index.ts",
    "lint": "oxlint",
    "sync-assets": "cp ../PROMPTS.json src/data/prompts.json && cp ../design-tokens.css src/data/design-tokens.css",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
